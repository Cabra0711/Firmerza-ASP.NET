# Copiar este archivo como ".env" y completar los valores antes de correr "docker compose up"

# Development expone /swagger; usar Production en un despliegue real para ocultarlo.
ASPNETCORE_ENVIRONMENT=Development

POSTGRES_DB=firmeza
POSTGRES_USER=postgres
POSTGRES_PASSWORD=firmeza123

# Generar una clave larga y aleatoria propia, no usar esta de ejemplo en producción
JWT_SECRET_KEY=CambiaEstaClavePorUnaLargaYAleatoriaAntesDeUsarEnProduccion

# Opcional: configuración SMTP para el correo de confirmación de compra
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@firmeza.com
