@model Firmeza.Response.ServiceResponse<IEnumerable<Firmeza.Models.Customer>>
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Dashboard Admin";

    var nombreAdmin = HttpContextAccessor.HttpContext?.Session.GetString("Username") ?? "Admin";
    var customers = (Model?.Data ?? Enumerable.Empty<Firmeza.Models.Customer>()).ToList();
    var activeCount = customers.Count(c => c.IsActive);
}

<div class="fixed inset-0 -z-10 overflow-hidden">

</div>
<!-- SideNavBar Anchor -->
<aside
    class="h-screen w-64 fixed left-0 top-0 border-r border-outline-variant/20 bg-surface-container/60 backdrop-blur-xl dark:bg-surface-container/60 shadow-xl flex flex-col py-lg z-50">
    <div class="px-md mb-xl">
        <h1 class="font-headline-md text-headline-md font-bold text-primary dark:text-primary-fixed-dim">
            StockStream</h1>
        <p class="font-label-md text-label-md text-on-surface-variant opacity-70">Admin Terminal</p>
    </div>
    <nav class="flex-1 space-y-xs">
        <!-- Mapping Dashboard -->
        <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface px-md py-sm hover:bg-surface-bright/50 transition-all duration-200 active:scale-95"
           asp-action="Admin" asp-controller="Firmeza">
            <span class="material-symbols-outlined">dashboard</span>
            <span class="font-body-md text-body-md">Products</span>
        </a>
        <!-- Mapping Users (Active for Client Management) -->
        <a class="flex items-center gap-md bg-primary/20 text-primary border-r-4 border-primary px-md py-sm transition-all duration-200"
           asp-controller="Firmeza" asp-action="Customer">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">group</span>
            <span class="font-body-md text-body-md">Users</span>
        </a>
        <!-- Mapping Orders -->
        <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface px-md py-sm hover:bg-surface-bright/50 transition-all duration-200 active:scale-95"
           asp-action="Sells" asp-controller="Firmeza">
            <span class="material-symbols-outlined">shopping_cart</span>
            <span class="font-body-md text-body-md">Sells</span>
        </a>
        <!-- Mapping Settings -->
        <a class="flex items-center gap-md text-on-surface-variant hover:text-on-surface px-md py-sm hover:bg-surface-bright/50 transition-all duration-200 active:scale-95"
           href="#">
            <span class="material-symbols-outlined">settings</span>
            <span class="font-body-md text-body-md">Settings</span>
        </a>
    </nav>
    <div class="mt-auto px-md pb-md flex items-center gap-md border-t border-outline-variant/20 pt-md">
        <div class="w-10 h-10 rounded-full bg-primary-container flex items-center justify-center relative">
            <span class="material-symbols-outlined text-on-primary-container text-2xl" style="font-variation-settings: 'FILL' 1;" data-icon="account_circle"></span>
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 absolute bottom-0 right-0 border-2 border-slate-900 animate-pulse"></div>
        </div>
        <div class="flex flex-col overflow-hidden">
            <span class="font-label-md text-label-md text-on-surface font-bold truncate">@nombreAdmin</span>
            <span class="text-[10px] text-on-surface-variant uppercase tracking-wider font-semibold">Rol: Administrador</span>
        </div>
        <a asp-controller="Firmeza" asp-action="Logout"
           class="p-2 text-on-surface-variant hover:text-error hover:bg-error/10 rounded-xl transition-all duration-200 flex items-center justify-center group"
           title="Cerrar sesión">
            <span class="material-symbols-outlined text-xl group-hover:scale-105 transition-transform" data-icon="logout"></span>
        </a>
    </div>
</aside>
<!-- Main Content Area -->
<main class="ml-64 min-h-screen flex flex-col">
    <!-- TopNavBar Anchor -->
    <header
        class="h-16 w-full flex justify-between items-center px-xl bg-surface-dim/40 backdrop-blur-md dark:bg-surface-dim/40 border-b border-outline-variant/10 shadow-sm sticky top-0 z-40">
        <form method="get" asp-action="Customer" class="flex items-center gap-lg flex-1">
            <div class="relative w-full max-w-md group">
                <span
                    class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant">search</span>
                <input name="search" value="@Context.Request.Query["search"]"
                    class="w-full bg-surface-container-low border-none rounded-lg pl-10 pr-4 py-2 focus:ring-2 focus:ring-primary/50 text-on-surface placeholder:text-on-surface-variant transition-all"
                    placeholder="Search customers..." type="text"/>
            </div>
            <button type="submit" class="px-md py-2 bg-primary text-on-primary rounded-lg font-label-md text-label-md">Search</button>
        </form>
    </header>
    <!-- Page Content -->
    <section class="p-xl space-y-xl">
        <!-- Header Section -->
        <div class="flex justify-between items-end">
            <div>
                <h2 class="font-headline-lg text-headline-lg text-on-surface">Client Management</h2>
                <p class="font-body-md text-body-md text-on-surface-variant">Manage your customer database and account
                    statuses.</p>
            </div>
            <div class="flex items-center gap-sm">
                <a asp-action="ExportCustomers" asp-controller="Firmeza" asp-route-format="xlsx"
                   class="px-md py-sm glass-panel rounded-lg flex items-center gap-xs text-sm text-primary" title="Exportar a Excel">
                    <span class="material-symbols-outlined text-[18px]">cloud_download</span> Excel
                </a>
                <a asp-action="ExportCustomers" asp-controller="Firmeza" asp-route-format="pdf"
                   class="px-md py-sm glass-panel rounded-lg flex items-center gap-xs text-sm text-primary" title="Exportar a PDF">
                    <span class="material-symbols-outlined text-[18px]">picture_as_pdf</span> PDF
                </a>
                <form asp-action="ImportCustomers" asp-controller="Firmeza" method="post" enctype="multipart/form-data" class="flex items-center gap-xs">
                    <input type="file" name="file" accept=".xlsx" required
                           class="text-xs text-on-surface-variant file:mr-sm file:py-2 file:px-md file:rounded-lg file:border-0 file:bg-surface-container-low file:text-primary file:cursor-pointer w-40" />
                    <button type="submit" class="px-md py-2 glass-panel rounded-lg text-primary" title="Importar Excel">
                        <span class="material-symbols-outlined text-[18px]">cloud_upload</span>
                    </button>
                </form>
            </div>
        </div>
        @if (TempData["ProductError"] != null)
        {
            <div class="p-md rounded-xl border border-error/30 bg-error/10 text-error text-sm">
                @TempData["ProductError"]
            </div>
        }
        <!-- Dashboard Stats Summary (Bento Style) -->
        <div class="grid grid-cols-12 gap-gutter">
            <div
                class="col-span-6 glass-panel p-lg rounded-xl flex flex-col justify-between h-32 relative overflow-hidden group">
                <div class="relative z-10">
                    <p class="text-label-md text-on-surface-variant uppercase tracking-widest">Total Clients</p>
                    <h3 class="font-display-lg text-display-lg text-primary">@customers.Count</h3>
                </div>
                <div class="absolute -right-4 -bottom-4 text-primary/10 transition-transform group-hover:scale-110">
                    <span class="material-symbols-outlined !text-7xl">groups</span>
                </div>
            </div>
            <div
                class="col-span-6 glass-panel p-lg rounded-xl flex flex-col justify-between h-32 relative overflow-hidden group">
                <div class="relative z-10">
                    <p class="text-label-md text-on-surface-variant uppercase tracking-widest">Active</p>
                    <h3 class="font-display-lg text-display-lg text-tertiary">@activeCount</h3>
                </div>
                <div class="absolute -right-4 -bottom-4 text-tertiary/10 transition-transform group-hover:scale-110">
                    <span class="material-symbols-outlined !text-7xl">bolt</span>
                </div>
            </div>
        </div>
        <!-- Customer Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-gutter">
            @if (customers.Count == 0)
            {
                <p class="text-on-surface-variant col-span-full text-center py-xl">No hay clientes registrados todavía.</p>
            }
            @foreach (var customer in customers)
            {
                <div class="glass-panel rounded-xl overflow-hidden group hover:border-primary/30 transition-all duration-300">
                    <div class="flex items-center gap-md p-md">
                        <div class="w-16 h-16 rounded-xl overflow-hidden flex-shrink-0 ring-2 ring-primary/20 bg-primary-container flex items-center justify-center">
                            <span class="material-symbols-outlined text-on-primary-container text-3xl">account_circle</span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-sm">
                                <div class="min-w-0">
                                    <h4 class="font-headline-md text-[18px] text-on-surface leading-tight truncate">@customer.UserName</h4>
                                    <p class="font-label-md text-label-md text-on-surface-variant font-normal lowercase truncate">@customer.Email</p>
                                </div>
                                <span class="flex-shrink-0 px-sm py-xs rounded-full text-[10px] font-bold uppercase tracking-widest @(customer.IsActive ? "bg-tertiary/10 text-tertiary border border-tertiary/20" : "bg-on-surface-variant/10 text-on-surface-variant border border-on-surface-variant/20")">
                                    @(customer.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="border-t border-outline-variant/20">
                        @if (customer.IsActive)
                        {
                            <form method="post" asp-action="DisableCustomer" asp-route-id="@customer.Id"
                                  onsubmit="return confirm('¿Deshabilitar a @customer.UserName?');">
                                <button type="submit"
                                    class="w-full flex items-center justify-center gap-xs py-sm text-on-surface-variant hover:bg-surface-bright/50 hover:text-on-surface transition-all active:scale-95 font-label-md text-label-md">
                                    <span class="material-symbols-outlined text-[18px]">block</span>
                                    Disable
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-action="EnableCustomer" asp-route-id="@customer.Id">
                                <button type="submit"
                                    class="w-full flex items-center justify-center gap-xs py-sm text-on-surface-variant hover:bg-surface-bright/50 hover:text-on-surface transition-all active:scale-95 font-label-md text-label-md">
                                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                    Enable
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</main>
<!-- Micro-interaction scripts -->
<script>
    document.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('mousedown', () => btn.classList.add('scale-95'));
        btn.addEventListener('mouseup', () => btn.classList.remove('scale-95'));
        btn.addEventListener('mouseleave', () => btn.classList.remove('scale-95'));
    });

    const searchInput = document.querySelector('input[type="text"]');
    const searchContainer = searchInput.parentElement;
    searchInput.addEventListener('focus', () => {
        searchContainer.classList.add('ring-2', 'ring-primary/50');
    });
    searchInput.addEventListener('blur', () => {
        searchContainer.classList.remove('ring-2', 'ring-primary/50');
    });
</script>
